ORCHESTRATOR_API_KEY=replace-with-a-long-random-token
WEB_SESSION_SECRET=replace-with-a-different-long-random-token
WEB_AUTH_USERNAME=admin
WEB_AUTH_PASSWORD=replace-with-a-long-random-password

# Optional Telegram bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_USER=admin
TELEGRAM_PERMISSION_MODE=workspace-write

# Optional web authentication hardening.
# WEB_AUTH_PASSWORD_HASH=
# WEB_AUTH_TOTP_SECRET=
# WEB_AUTH_ORIGIN=https://codex-orchestrator.example.com
# WEB_AUTH_RP_ID=codex-orchestrator.example.com

